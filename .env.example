# Neurova 后端环境变量配置
# 复制此文件为 .env 并修改配置

# ============================================
# 服务器配置
# ============================================
NEUROVA_HOST=0.0.0.0
NEUROVA_PORT=9527
NEUROVA_DEBUG=false

# ============================================
# 安全配置
# ============================================
# JWT 密钥（生产环境请使用强随机密钥）
NEUROVA_JWT_SECRET=your-secret-key-change-in-production

# ============================================
# LLM 配置
# ============================================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# 本地 LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# 数据库配置
# ============================================
# SQLite 数据库路径（默认: ./data/neurova.db）
NEUROVA_DB_PATH=./data/neurova.db

# ============================================
# 日志配置
# ============================================
NEUROVA_LOG_LEVEL=INFO
NEUROVA_LOG_FILE=./logs/neurova.log

# ============================================
# 前端配置
# ============================================
# 前端 URL（用于 CORS 配置）
NEUROVA_FRONTEND_URL=http://localhost:8100

# ============================================
# NeurFlow — 图像生成 API
# ============================================
# OpenAI DALL-E
NEUROVA_IMAGE_OPENAI_KEY=
NEUROVA_OPENAI_API_KEY=
# 可灵 Kling
NEUROVA_IMAGE_KLING_KEY=
NEUROVA_KLING_API_KEY=
# 即梦 Jimeng
NEUROVA_IMAGE_JIMENG_KEY=
NEUROVA_JIMENG_API_KEY=
# 通义万相 Wanx
NEUROVA_IMAGE_WANX_KEY=
NEUROVA_WANX_API_KEY=
NEUROVA_DASHSCOPE_API_KEY=
# Stability
NEUROVA_IMAGE_STABILITY_KEY=
NEUROVA_STABILITY_API_KEY=

# ============================================
# NeurFlow — 视频生成 API
# ============================================
NEUROVA_VIDEO_KLING_KEY=
NEUROVA_VIDEO_JIMENG_KEY=
NEUROVA_VIDEO_RUNWAY_KEY=
NEUROVA_VIDEO_PIKA_KEY=

# ============================================
# NeurFlow — 视频发布平台凭证
# ============================================
NEUROVA_DOUYIN_ACCESS_TOKEN=
NEUROVA_KUAISHOU_ACCESS_TOKEN=
NEUROVA_BILIBILI_ACCESS_TOKEN=
NEUROVA_TIKTOK_ACCESS_TOKEN=
NEUROVA_XIAOHONGSHU_ACCESS_TOKEN=

# ============================================
# NeurFlow — 电商平台 API Key
# ============================================
# 亚马逊 SP-API（LWA 授权三件套，见 developer-docs.amazon.com/sp-api）
# refresh_token：卖家授权应用后获得的 LWA 刷新令牌
# client_id / client_secret：应用注册后的 LWA 凭据
NEUROVA_AMAZON_SP_REFRESH_TOKEN=
NEUROVA_AMAZON_SP_CLIENT_ID=
NEUROVA_AMAZON_SP_CLIENT_SECRET=
# 亚马逊广告 Amazon Ads API（独立开放平台，LWA client_credentials）
NEUROVA_AMAZON_ADS_CLIENT_ID=
NEUROVA_AMAZON_ADS_CLIENT_SECRET=
# 淘宝开放平台 TOP（open.taobao.com；app_key/app_secret + access_token 或 refresh_token）
NEUROVA_TAOBAO_APP_KEY=
NEUROVA_TAOBAO_APP_SECRET=
NEUROVA_TAOBAO_ACCESS_TOKEN=
NEUROVA_TAOBAO_REFRESH_TOKEN=
# 京东开放平台（open.jd.com）
NEUROVA_JD_APP_KEY=
NEUROVA_JD_APP_SECRET=
NEUROVA_JD_ACCESS_TOKEN=
NEUROVA_JD_REFRESH_TOKEN=
# 拼多多开放平台（open.pinduoduo.com；client_id/client_secret）
NEUROVA_PDD_CLIENT_ID=
NEUROVA_PDD_CLIENT_SECRET=
NEUROVA_PDD_ACCESS_TOKEN=
NEUROVA_PDD_REFRESH_TOKEN=
# 抖店开放平台（op.jinritemai.com）
NEUROVA_DOUYIN_ECOM_APP_KEY=
NEUROVA_DOUYIN_ECOM_APP_SECRET=
NEUROVA_DOUYIN_ECOM_ACCESS_TOKEN=
NEUROVA_DOUYIN_ECOM_REFRESH_TOKEN=
# TikTok Shop 开放平台（partner.tiktokshop.com）
NEUROVA_TIKTOK_SHOP_APP_KEY=
NEUROVA_TIKTOK_SHOP_APP_SECRET=
NEUROVA_TIKTOK_SHOP_ACCESS_TOKEN=
NEUROVA_TIKTOK_SHOP_REFRESH_TOKEN=
# 1688 开放平台（ocean 网关；建议改用画布"店铺管理"连接，见 docs/neurflow-store-connection-design.md）
NEUROVA_1688_API_KEY=
NEUROVA_1688_API_SECRET=
NEUROVA_1688_ACCESS_TOKEN=
NEUROVA_1688_REFRESH_TOKEN=
# 小红书开放平台（ark 网关；商家自研/ISV 双路径资质准入）
NEUROVA_XIAOHONGSHU_API_KEY=
NEUROVA_XIAOHONGSHU_APP_SECRET=
NEUROVA_XIAOHONGSHU_ACCESS_TOKEN=
NEUROVA_XIAOHONGSHU_REFRESH_TOKEN=
# 闲鱼开放平台（TOP 生态；运营定向邀请准入）
NEUROVA_XIANYU_API_KEY=
NEUROVA_XIANYU_APP_SECRET=
NEUROVA_XIANYU_ACCESS_TOKEN=
NEUROVA_XIANYU_REFRESH_TOKEN=
# SHEIN 无面向卖家的开放 API，通用兜底键
NEUROVA_SHEIN_API_KEY=
