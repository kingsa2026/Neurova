# 版本控制
.git
.gitignore

# 虚拟环境
.venv
venv
ENV

# IDE
.vscode
.idea
*.swp
*.swo

# 测试
tests
test_*.py
*_test.py
pytest_output.txt
.coverage
htmlcov/

# 文档
docs
*.md
!README.md

# 日志
logs/
*.log

# 临时文件
temp/
tmp/
*.tmp
*.bak

# 数据文件
data/
*.db
*.db-shm
*.db-wal

# 会话文件
sessions/
session/

# 上传文件
uploads/

