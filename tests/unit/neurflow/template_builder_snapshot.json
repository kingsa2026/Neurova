       "description": "数据来源（URL、文件路径或描述）"
      },
      "analysis_goal": {
       "type": "textarea",
       "required": true,
       "description": "分析目标"
      },
      "output_format": {
       "type": "select",
       "options": [
        "HTML报告",
        "PDF报告",
        "Markdown",
        "JSON数据"
       ],
       "default": "HTML报告",
       "description": "输出格式"
      }
     }
    },
    "label": "开始",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "fetch_data",
    "type": "builtin:web-scrape",
    "position": {
     "x": 400,
     "y": 100
    },
    "config": {
     "url": "{{data_source}}",
     "selector": "auto",
     "pagination": false
    },
    "label": "数据抓取",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "clean_data",
    "type": "builtin:llm",
    "position": {
     "x": 700,
     "y": 100
    },
    "config": {
     "prompt": "清洗以下数据：\n\n原始数据：{{fetch_data.output}}\n分析目标：{{analysis_goal}}\n\n要求：\n1. 处理缺失值\n2. 标准化格式\n3. 去除异常值\n4. 为分析做准备\n\n输出清洗后的数据：",
     "temperature": 0.2,
     "max_tokens": 2000
    },
    "label": "数据清洗",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "analyze_data",
    "type": "builtin:data-analyze",
    "position": {
     "x": 1000,
     "y": 100
    },
    "config": {
     "data": "{{clean_data.output}}",
     "analysis_type": "comprehensive",
     "columns": "auto"
    },
    "label": "数据分析",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "visualize",
    "type": "builtin:data-visualize",
    "position": {
     "x": 1300,
     "y": 50
    },
    "config": {
     "data": "{{analyze_data.output}}",
     "chart_type": "auto",
     "x_axis": "auto",
     "y_axis": "auto"
    },
    "label": "数据可视化",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "generate_report",
    "type": "builtin:llm",
    "position": {
     "x": 1300,
     "y": 200
    },
    "config": {
     "prompt": "生成数据分析报告：\n\n分析结果：{{analyze_data.output}}\n可视化图表：{{visualize.output}}\n分析目标：{{analysis_goal}}\n\n要求：\n1. 包含执行摘要\n2. 详细分析结果\n3. 关键发现\n4. 建议和结论\n5. 图表说明\n\n输出格式：{{output_format}}",
     "temperature": 0.3,
     "max_tokens": 3000
    },
    "label": "报告生成",
    "enabled": true,
    "metadata": {},
    "mock_output": null
   },
   {
    "id": "end",
    "type": "builtin:end",
    "position": {
     "x": 1600,
     "y": 100
    },
    "config": {
     "output_mapping": {
      "analysis": "{{analyze_data.output}}",
      "visualization": "{{visualize.output}}",
      "report": "{{generate_report.output}}",
      "format": "{{output_format}}"
     }
