 "programming": {
  "nodes": [
   {
    "id": "start",
    "type": "builtin:start",
    "position": {
     "x": 100,
     "y": 100
    },
    "config": {
     "inputs_schema": {
      "requirements": {
       "type": "textarea",
       "required": true,
       "description": "编程需求描述"
      },
      "language": {
       "type": "select",
       "options": [
        "Python",
        "JavaScript",
        "TypeScript",
        "Java",
        "Go"
       ],
       "default": "Python",
       "description": "目标编程语言"
      },
      "test_framework": {
       "type": "select",
       "options": [
        "pytest",
        "jest",
        "junit",
        "go test"
       ],
       "default": "pytest",
       "description": "测试框架"
      }
     }
    },
    "label": "开始",
    "enabled": true,
    "metadata": {
     "category": "flow"
    },
    "mock_output": null
   },
   {
    "id": "analyze_requirements",
    "type": "builtin:llm",
    "position": {
     "x": 400,
     "y": 100
    },
    "config": {
     "prompt": "分析以下编程需求，并生成详细的技术规格：\n\n需求：{{requirements}}\n编程语言：{{language}}\n测试框架：{{test_framework}}\n\n请提供：\n1. 功能分解（主要模块和函数）\n2. 接口设计（输入/输出）\n3. 测试用例设计（边界条件、正常流程、异常情况）\n4. 实现策略（算法选择、数据结构）\n\n输出格式：JSON",
     "temperature": 0.3,
     "max_tokens": 2000
    },
    "label": "需求分析",
    "enabled": true,
    "metadata": {
     "category": "ai"
    },
    "mock_output": null
   },
   {
    "id": "tdd_implementation",
    "type": "builtin:tdd",
    "position": {
     "x": 700,
     "y": 100
    },
    "config": {
     "test_spec": "根据以下技术规格生成测试用例：\n\n{{analyze_requirements.output}}\n\n编程语言：{{language}}\n测试框架：{{test_framework}}\n\n要求：\n1. 覆盖所有功能点\n2. 包含边界条件测试\n3. 包含异常处理测试\n4. 测试代码可直接运行",
     "implementation_prompt": "根据以下测试用例实现代码：\n\n{{tdd_implementation.tests}}\n\n技术规格：\n{{analyze_requirements.output}}\n\n要求：\n1. 实现所有测试用例\n2. 代码简洁、可读\n3. 遵循最佳实践\n4. 包含必要的错误处理",
     "max_iterations": 5,
     "pass_threshold": 0.9
    },
    "label": "TDD 实现",
    "enabled": true,
    "metadata": {
     "category": "ai"
    },
    "mock_output": null
   },
   {
    "id": "code_review",
    "type": "builtin:llm",
    "position": {
     "x": 1000,
     "y": 100
    },
    "config": {
     "prompt": "审查以下代码实现：\n\n实现代码：\n{{tdd_implementation.output}}\n\n测试结果：\n{{tdd_implementation.tests}}\n\n请提供：\n1. 代码质量评分（1-10）\n2. 性能分析\n3. 安全性检查\n4. 改进建议\n5. 重构建议（如果需要）\n\n输出格式：JSON",
     "temperature": 0.2,
     "max_tokens": 1500
    },
    "label": "代码审查",
    "enabled": true,
    "metadata": {
     "category": "ai"
    },
    "mock_output": null
   },
   {
    "id": "quality_check",
    "type": "builtin:condition",
    "position": {
     "x": 1300,
     "y": 100
    },
    "config": {
     "expression": "{{code_review.output.score}} >= 8",
     "branches": [
      {
       "label": "高质量",
       "condition": "true"
      },
      {
       "label": "需要改进",
       "condition": "false"
      }
     ]
    },
    "label": "质量检查",
    "enabled": true,
    "metadata": {
     "category": "flow"
    },
    "mock_output": null
   },
   {
    "id": "evolution_learning",
    "type": "builtin:evolution",
    "position": {
     "x": 1600,
     "y": 50
    },
    "config": {
     "mode": "learn",
     "feedback_data": {
      "task_type": "code_generation",
      "language": "{{language}}",
      "quality_score": "{{code_review.output.score}}",
      "test_pass_rate": "{{tdd_implementation.pass_rate}}",
      "implementation": "{{tdd_implementation.output}}",
      "review": "{{code_review.output}}"
     }
    },
    "label": "进化学习",
    "enabled": true,
    "metadata": {
     "category": "ai"
    },
    "mock_output": null
   },
   {
    "id": "code_optimization",
    "type": "builtin:llm",
    "position": {
     "x": 1600,
     "y": 200
    },
    "config": {
     "prompt": "根据审查结果优化代码：\n\n原始实现：\n{{tdd_implementation.output}}\n\n审查反馈：\n{{code_review.output}}\n\n要求：\n1. 应用所有改进建议\n2. 保持测试通过\n3. 提高代码质量\n\n输出优化后的代码：",
     "temperature": 0.3,
     "max_tokens": 2000
    },
    "label": "代码优化",
    "enabled": true,
    "metadata": {
     "category": "ai"
    },
    "mock_output": null
   },
   {
    "id": "merge_results",
    "type": "builtin:merge",
    "position": {
     "x": 1900,
     "y": 100
    },
    "config": {
     "strategy": "first"
    },
    "label": "合并结果",
    "enabled": true,
    "metadata": {
     "category": "flow"
    },
    "mock_output": null
   },
   {
    "id": "end",
    "type": "builtin:end",
    "position": {
     "x": 2200,
     "y": 100
    },
    "config": {
     "output_mapping": {
      "code": "{{tdd_implementation.output}}",
      "tests": "{{tdd_implementation.tests}}",
      "quality_score": "{{code_review.output.score}}",
      "review": "{{code_review.output}}",
      "language": "{{language}}"
     }
    },
    "label": "结束",
    "enabled": true,
    "metadata": {
     "category": "flow"
    },
    "mock_output": null
   }
