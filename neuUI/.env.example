# ============================================
# Neurova Frontend Environment Variables
# ============================================

# API Configuration
# 生产环境使用完整 URL（绕过 vite 代理），开发环境使用相对路径
# Vite 代理 /api/* -> http://localhost:9527/* (自动去掉 /api 前缀)
# 后端路由前缀是 /v1，所以完整路径是 /api/v1/*
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Application
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=Neurova

# Build Mode
# NODE_ENV=development|production|test
