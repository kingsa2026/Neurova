<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 设备桥常驻连接（2026-11-23 计划卡 A1）：前台服务承载应用级 WS，退后台不断连 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知采集（2026-11-23 计划卡 A5；D3：全量采集+白名单授权） -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 设备桥 open_app/app_list 的包可见性（API 30+）：只申请主入口应用可见，不取全量安装清单 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 扫码配对协议：neurova://pair?ref=…（两端同一事实源，见《中继方案》§3.4） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neurova" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- 设备桥前台服务：持有应用级 WS 常连，执行 device:execute 并回执 -->
        <service
            android:name=".core.service.DeviceBridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FCM 推送接收（B7）：只消费唤醒信令（device_command_pending），正文不过推送通道 -->
        <service
            android:name=".core.push.NeurovaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 无障碍执行器（2026-11-23 计划卡 A4）：读屏 + 手势注入；
             用户须在系统设置显式开启，App 侧另有武装窗口按需生效 -->
        <service
            android:name=".core.accessibility.ExecutorAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知采集（2026-11-23 计划卡 A5）：用户在系统设置授权后系统拉起 -->
        <service
            android:name=".core.notification.NeurovaNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
