{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neurova",
  "version": "1.0.0-beta1",
  "identifier": "io.neurova.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8100",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Neurova 智星",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "11F098DB1C2E2EB47BD74CF82059A81A046A8757",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
