{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neurova",
  "version": "1.0.0",
  "identifier": "io.neurova.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8100",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Neurova 智星",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/backend/python": "backend/python",
      "resources/backend/neurova": "backend/neurova",
      "resources/backend/models": "backend/models",
      "resources/backend/config": "backend/config",
      "resources/backend/start_server.py": "backend/start_server.py"
    }
  }
}
